---
// Intro: three screens (wireframe "Intro" + the updated Home layout).
//   1. Cream. "Food nurtures us every single day!", the food cluster, a brown path that winds down from it.
//   2. Brown ground. "Every ingredient we love..." and "Pero tumatanda na ang mga magsasaka natin."
//   3. The farmer photo. "Tara, sama-sama nating simulan ang bagong henerasyon ng agrikultura!"
// Screens 1 and 2 are one continuous drawing (the path flows into the ground), so they share the .story box.
// With animations on, the whole intro is ONE held stage: the scroll pans down the drawing (screen 1 into
// screen 2), opens the photo (screen 3), and then the hero rises over the photo (see setupIntro() in
// home-animations.js). The stage is `position: sticky` inside a tall track; JS sets the track's height.
// Desktop positions are the layout's, in units of --u (1% of the width, 1440px design); the food cluster
// uses its own unit --cu so the same markup scales down on phones. See home-animations.js for the motion.
import Photo from './Photo.astro';
---

<div class="intro">
<div class="intro__stage">
<section class="story" data-nav="light" aria-label="Introduction">
  <!-- Desktop: the brown ground and the path (drawn from the layout). The path is revealed through a mask
       whose centerline is drawn on load (home-animations.js). Only the painted brown (not the empty parts) counts as a dark section for the header. -->
  <svg class="story__art" viewBox="0 0 1440 1846" aria-hidden="true" focusable="false">
    <defs>
      <mask id="ribbon-mask" maskUnits="userSpaceOnUse" x="-200" y="0" width="1840" height="1846">
        <path class="ribbon-draw" d="M1039 522C1004 527 897 541 828 554C759 568 684 581 625 601C565 620 512 644 470 671C428 698 392 732 373 765C354 798 356 834 356 870C356 906 371 943 373 982C375 1022 369 1062 368 1109C367 1156 368 1237 368 1263" fill="none" stroke="#fff" stroke-width="440" stroke-linecap="round" />
      </mask>
    </defs>
    <path class="story__ground" data-nav="dark" d="M-2400 1060 L0 1060C23 1065 90 1084 140 1095C191 1106 248 1117 302 1126C356 1134 408 1147 463 1144C518 1141 578 1125 632 1109C685 1092 732 1062 786 1046C840 1029 901 1015 954 1008C1008 1000 1057 998 1109 999C1160 1001 1208 1006 1263 1018C1318 1029 1391 1055 1440 1067C1489 1079 1538 1085 1558 1089L3840 1089 V1850 H-2400 Z" />
    <g mask="url(#ribbon-mask)"><path class="story__ribbon" data-nav="dark" d="M1032 505C1002 507 906 512 856 516C806 521 770 526 730 533C690 541 657 550 618 560C578 570 532 581 494 595C456 609 417 625 387 643C357 661 333 679 314 702C296 725 286 753 278 780C270 808 268 837 268 865C269 893 276 922 281 949C286 975 296 1001 298 1025C299 1048 292 1055 289 1088C286 1120 282 1199 281 1221L466 1221C466 1208 465 1170 467 1144C470 1118 475 1092 479 1067C482 1041 491 1016 488 990C486 963 472 935 465 905C457 876 447 840 445 814C443 788 445 770 453 751C461 732 475 716 493 702C510 688 534 676 560 665C586 655 614 647 647 639C680 630 723 622 759 615C796 607 835 601 865 592C894 584 907 574 935 564C963 554 1015 538 1032 533Z" /></g>
  </svg>

  <div class="story__a">
  <p class="s-head" data-split data-split-load>
    <span class="ln">Food nurtures us</span>
    <span class="ln accent">every single day!</span>
  </p>

  <div class="s-cluster" aria-hidden="true">
    <svg class="s-splat" viewBox="0 0 100 160" focusable="false"><g fill="#de6822"><circle cx="50" cy="26" r="25" /><circle cx="22" cy="72" r="24" /><circle cx="78" cy="66" r="22" /><circle cx="46" cy="120" r="27" /><circle cx="50" cy="74" r="27" /></g></svg>
    <img class="s-fish" src="/images/intro/food-fish.webp" width="311" height="179" alt="" decoding="async" />
    <span class="s-hole"></span>
    <svg class="s-blob" viewBox="0 0 100 124" focusable="false"><path d="M22 22L68 6L94 40L66 114L14 96Z" fill="#e5dc72" stroke="#e5dc72" stroke-width="12" stroke-linejoin="round" /></svg>
    <img class="s-bok" src="/images/intro/food-bokchoy.webp" width="264" height="277" alt="" decoding="async" />
    <img class="s-lettuce" src="/images/intro/food-lettuce.webp" width="198" height="178" alt="" decoding="async" />
    <img class="s-rice" src="/images/intro/food-rice.webp" width="221" height="175" alt="" decoding="async" />
  </div>

  <p class="s-note">
    <span class="ln">At sa bawat kain</span>
    <span class="ln">natin, may kwentong</span>
    <span class="ln accent">nagmumula sa lupa.</span>
  </p>
  </div>

  <!-- Small cue that the page continues by scrolling. Fades out as soon as scrolling starts. -->
  <a class="s-cue" href="#home" aria-label="Scroll to continue">
    <span>Scroll</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v15M6 13l6 6 6-6" /></svg>
  </a>

  <!-- Screen 2. On desktop this wrapper has no box of its own (the ground is part of the drawing above). -->
  <div class="story__b" data-nav="dark">
    <svg class="story__wave" viewBox="0 0 390 48" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 48V22C40 6 86 4 130 14C186 27 214 36 270 26C320 17 356 6 390 12V48Z" /></svg>
    <p class="s-quote">
      <span class="ln">Every ingredient we</span>
      <span class="ln">love, every meal we</span>
      <span class="ln">share, <span class="yel">began with a</span></span>
      <span class="ln yel">farmer&rsquo;s care.</span>
    </p>
    <p class="s-pero">
      <span class="ln"><span class="mark">Pero tumatanda</span></span>
      <span class="ln">na ang mga</span>
      <span class="ln">magsasaka natin.</span>
    </p>
  </div>
</section>

<section class="frame frame--photo" data-nav="dark" aria-label="Introduction, continued">
  <div class="frame2__photo">
    <Photo src="intro/farmer-field.webp" alt="A farmer bent over a field of young crops" srcset="/images/intro/farmer-field-640.webp 640w, /images/intro/farmer-field-960.webp 960w, /images/intro/farmer-field.webp 1368w" sizes="100vw" />
  </div>
  <span class="frame2__ring" aria-hidden="true"></span>

  <div class="frame2__text">
    <p class="frame2__title">
      <span class="ln">Tara, sama-sama</span>
      <span class="ln">nating simulan</span>
      <span class="ln hl">ang bagong</span>
      <span class="ln hl">henerasyon ng</span>
      <span class="ln hl">agrikultura!</span>
    </p>
  </div>
</section>
<span class="intro__shade" aria-hidden="true"></span>
</div>
</div>

<style>
  .ln {
    display: block;
  }

  .accent {
    color: var(--orange-ink);
  }

  /* shared headline style for the intro: heavy rounded sans, tight, sentence case (as in the layout) */
  .s-head,
  .s-note,
  .s-quote,
  .s-pero,
  .frame2__title {
    font-family: var(--font-sub);
    word-spacing: var(--sub-ws);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  /* ================= Phones and tablets: stacked ================= */
  .story {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 1.5rem;
    padding: 6.5rem var(--gutter) 0;
    background: var(--cream);
    color: var(--brown);
  }

  .story__art {
    display: none;
  }

  .s-head,
  .s-note {
    font-size: clamp(1.9rem, 8.4vw, 3.2rem);
  }

  .s-note {
    justify-self: end;
    text-align: right;
  }

  .s-cue {
    display: none;
  }

  /* phones and tablets: screen 1 fills one screen (headline at the top, the note at the bottom) */
  .story__a {
    display: grid;
    gap: 1.5rem;
    align-content: space-between;
    min-height: calc(100svh - 6.5rem);
    padding-bottom: 2.6rem;
  }

  /* the food cluster is drawn in its own unit (--cu), so it scales as one picture */
  .s-cluster {
    --cu: calc(min(100vw - var(--gutter) * 2, 25rem) / 39);
    position: relative;
    width: calc(var(--cu) * 39);
    height: calc(var(--cu) * 26.2);
    justify-self: center;
  }

  .s-cluster > * {
    position: absolute;
  }

  .s-cluster img {
    max-width: none;
    height: auto;
    user-select: none;
  }

  .s-splat {
    left: calc(var(--cu) * -0.6);
    top: calc(var(--cu) * 8.6);
    width: calc(var(--cu) * 9.8);
    height: auto;
    transform: rotate(-10deg);
  }

  .s-fish {
    left: calc(var(--cu) * 6.3);
    top: calc(var(--cu) * 2.4);
    width: calc(var(--cu) * 20);
  }

  .s-hole {
    left: calc(var(--cu) * 15);
    top: calc(var(--cu) * 7.8);
    width: calc(var(--cu) * 7.6);
    height: calc(var(--cu) * 7.2);
    border-radius: 50%;
    background: var(--brown);
  }

  .s-blob {
    left: calc(var(--cu) * 28.3);
    top: calc(var(--cu) * 12.2);
    width: calc(var(--cu) * 10.2);
    height: auto;
  }

  .s-bok {
    left: calc(var(--cu) * 22.4);
    top: calc(var(--cu) * 0.4);
    width: calc(var(--cu) * 16.5);
  }

  .s-lettuce {
    left: calc(var(--cu) * 5.1);
    top: calc(var(--cu) * 8.4);
    width: calc(var(--cu) * 12);
  }

  .s-rice {
    left: calc(var(--cu) * 13.1);
    top: calc(var(--cu) * 14);
    width: calc(var(--cu) * 16.1);
  }

  /* screen 2: a brown panel with a wavy top edge */
  .story__b {
    position: relative;
    display: grid;
    gap: 2rem;
    align-content: center;
    min-height: 100svh;
    margin: 0 calc(var(--gutter) * -1);
    padding: 3.5rem var(--gutter) 4.5rem;
    background: var(--brown);
    color: var(--cream);
  }

  .story__wave {
    position: absolute;
    left: 0;
    right: 0;
    top: -2.9rem;
    width: 100%;
    height: 3rem;
    fill: var(--brown);
  }

  .s-quote,
  .s-pero {
    font-size: clamp(1.8rem, 7.8vw, 3rem);
  }

  .s-quote {
    justify-self: end;
    text-align: right;
  }

  .yel {
    color: var(--yellow);
  }

  .s-pero .mark {
    display: inline-block;
    padding: 0.02em 0.14em;
    margin-left: -0.14em;
    color: var(--cream);
    background: linear-gradient(var(--orange), var(--orange)) no-repeat 0 0 / var(--mark, 100%) 100%;
  }

  /* screen 3: the photo */
  .frame--photo {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 5rem var(--gutter);
    background: var(--green-deep);
    color: var(--cream);
  }

  .frame2__photo {
    --photo-empty-bg: #5b6a45;
    position: absolute;
    inset: 0;
  }

  .frame2__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(20, 20, 10, 0.45), rgba(20, 20, 10, 0.05) 70%);
  }

  .frame2__ring {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 62%;
    height: 40%;
    background: radial-gradient(ellipse 100% 100% at 100% 100%, transparent 0 26%, var(--green) 26.5% 99.5%, transparent 100%);
  }

  .frame2__text {
    position: relative;
  }

  .frame2__title {
    font-size: clamp(2.1rem, 9.4vw, 3.6rem);
    line-height: 1.08;
    color: var(--cream);
  }

  .hl {
    color: var(--yellow);
  }


  /* ================= Desktop: the layout, in proportions of the 1440px design ================= */
  @media (min-width: 960px) {
    .story {
      display: block;
      height: calc(var(--u) * 128.2);
      padding: 0;
    }

    /* screen 1's pieces are positioned on the story itself */
    .story__a {
      display: contents;
    }

    .story__art {
      display: block;
      position: absolute;
      left: var(--gx);
      top: 0;
      width: calc(var(--u) * 100);
      height: calc(var(--u) * 128.2);
      overflow: visible;
    }

    .story__ground,
    .story__ribbon {
      fill: var(--brown);
    }

    .s-head,
    .s-note,
    .s-quote,
    .s-pero {
      position: absolute;
      font-size: calc(var(--u) * 3.85);
      line-height: 1;
    }

    .s-head {
      left: calc(var(--gx) + var(--u) * 12.2);
      top: calc(var(--u) * 23.4);
    }

    .s-cluster {
      --cu: var(--u);
      position: absolute;
      left: calc(var(--gx) + var(--u) * 50.7);
      top: calc(var(--u) * 16.6);
      justify-self: auto;
    }

    .s-note {
      right: calc(var(--gx) + var(--u) * 10.8);
      top: calc(var(--u) * 51);
      justify-self: auto;
    }

    .s-cue {
      position: absolute;
      left: 50%;
      top: calc(100svh - var(--u) * 5.6);
      z-index: 3;
      display: grid;
      justify-items: center;
      gap: 0.15rem;
      transform: translateX(-50%);
      font-family: var(--font-sub);
      word-spacing: var(--sub-ws);
      font-size: calc(var(--u) * 1);
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--cream);
    }

    .s-cue svg {
      width: 1.5rem;
      height: 1.5rem;
      animation: cue-bob 1.8s ease-in-out infinite;
    }

    @keyframes cue-bob {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(5px);
      }
    }

    /* screen 2 has no box of its own here: its pieces are positioned on the story */
    .story__b {
      display: contents;
    }

    .story__wave {
      display: none;
    }

    .s-quote {
      right: calc(var(--gx) + var(--u) * 11.3);
      top: calc(var(--u) * 84.3);
      justify-self: auto;
    }

    .s-pero {
      left: calc(var(--gx) + var(--u) * 13.2);
      top: calc(var(--u) * 104.1);
    }

    .frame--photo {
      min-height: max(100svh, calc(var(--u) * 58.5));
      padding: 0;
      display: block;
    }

    .frame2__ring {
      width: calc(var(--u) * 34);
      height: calc(var(--u) * 46);
    }

    .frame2__text {
      position: absolute;
      left: calc(var(--gx) + var(--u) * 8.8);
      top: calc(var(--u) * 16.5);
    }

    .frame2__title {
      font-size: calc(var(--u) * 4.3);
      line-height: 1.1;
    }
  }

  /* ================= Animations on: one held stage =================
     The three screens live in a single 100vh stage that sticks to the top of a tall track while the scroll
     runs (the track's height is set in home-animations.js). The story (screens 1 and 2) is taller than the
     stage and is panned up by the scroll; the photo (screen 3) sits on top behind a closed circle that opens.
     Without scripts, with reduced motion, or if the animation cannot start, none of this applies and the
     three screens simply stack. */
  /* The track's height is set exactly by home-animations.js. This is the same sum worked out in CSS, so the
     very first paint already has the right height and nothing below (the hero) jumps when the script takes over.
       height = stage + scroll run + stage, with scroll run = 1.1 x pan + 1.15 x stage, pan = story - stage.
     On phones the story is two screens tall (one per screen), so the pan is one screen. */
  :global(html.js:not(.rm):not(.anim-fail)) {
    --stage: 100svh;
  }

  /* phones: the stage is as tall as the screen with the browser toolbar tucked away, so scrolling that
     collapses the toolbar never shows a strip under it. Screen 1's content is still laid out for the
     smaller visible height (svh), so nothing is hidden behind the toolbar. */
  @media (max-width: 959px) {
    @supports (height: 100lvh) {
      :global(html.js:not(.rm):not(.anim-fail)) {
        --stage: 100lvh;
      }
    }
  }

  :global(html.js:not(.rm):not(.anim-fail)) .intro {
    --intro-pan: max(0px, calc(200svh - var(--stage)));
    position: relative;
    height: calc(var(--stage) * 3.15 + var(--intro-pan) * 1.1);
  }

  @media (min-width: 960px) {
    :global(html.js:not(.rm):not(.anim-fail)) .intro {
      --intro-pan: max(0px, calc(var(--u) * 128.2 - var(--stage)));
    }
  }

  :global(html.js:not(.rm):not(.anim-fail)) .intro__stage {
    position: sticky;
    top: 0;
    z-index: 1;
    height: var(--stage);
    overflow: hidden;
    background: var(--green-deep); /* shows around the photo while it sinks back under the hero */
  }

  :global(html.js:not(.rm):not(.anim-fail)) .intro .story {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
  }

  :global(html.js:not(.rm):not(.anim-fail)) .intro__shade {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: #140f06;
    opacity: 0;
    pointer-events: none;
  }

  :global(html.js:not(.rm):not(.anim-fail)) .intro .frame--photo {
    position: absolute;
    inset: 0;
    z-index: 2;
    min-height: 0;
    clip-path: circle(0% at 10% 100%);
  }
</style>
