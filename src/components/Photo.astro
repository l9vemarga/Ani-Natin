---
// Asset slot. Looks for /public/images/<src>. If the file exists it is shown; if not, a labeled
// placeholder shows exactly which file is needed. Drop the file in and rebuild: no code change.
// The full list of needed files is in ASSETS.md.
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  src: string;
  alt: string;
  fit?: 'cover' | 'contain';
  position?: string;
  class?: string;
}

const { src, alt, fit = 'cover', position = 'center', class: className } = Astro.props;
const exists = fs.existsSync(path.join(process.cwd(), 'public', 'images', src));
---

{exists ? (
  <img
    class:list={['photo', className]}
    src={`/images/${src}`}
    alt={alt}
    loading="lazy"
    decoding="async"
    style={`object-fit:${fit};object-position:${position}`}
  />
) : (
  <div class:list={['photo', 'photo--empty', className]} role="img" aria-label={`Placeholder: ${alt}`}>
    <span class="photo__need">Needs: images/{src}</span>
  </div>
)}

<style>
  .photo {
    display: block;
    width: 100%;
    height: 100%;
  }

  .photo--empty {
    display: grid;
    place-items: center;
    padding: 0.75rem;
    background:
      repeating-linear-gradient(135deg, rgba(0, 0, 0, 0.06) 0 12px, rgba(0, 0, 0, 0.12) 12px 24px),
      var(--photo-empty-bg, var(--lime));
    color: var(--photo-empty-fg, var(--green));
    border: 2px dashed currentColor;
  }

  .photo__need {
    max-width: 100%;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgba(250, 228, 188, 0.85);
    color: var(--green);
    font-family: var(--font-sub);
    word-spacing: var(--sub-ws);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    overflow-wrap: anywhere;
  }
</style>
