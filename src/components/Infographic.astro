---
// "What do you actually do in Agri?" (the updated Home layout): a plant at the top, and a long vine that grows
// down the page through five stations (Organic Agriculture, Agricultural Crops Production, Horticulture,
// Aquaculture, Food Processing). Each station has an icon badge, a label and a speech bubble that lies on the
// vine. The vine follows the visitor as they scroll, and each icon wakes up when the vine reaches it
// (vine-scroll.js). Everything is drawn in code from the layout; the five icons are stand-in artwork.
//
// Desktop (960px and up): one SVG in the 1440px design (1440 x 2760), centered on wider screens.
// Phones and tablets: a straight-down version, with the stations as a list and the vine running beside it.
import Scribble from './Scribble.astro';
import VineIcon from './VineIcon.astro';
import VinePlant from './VinePlant.astro';

// ---- geometry: traced on a 1026-wide enlargement of the layout, converted to the 1440 design ----
const F = 1440 / 1026;
const E = (x, y) => [+(x * F).toFixed(1), +(y * F).toFixed(1)];

function spline(pts) {
  const n = pts.length;
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 0; i < n - 1; i++) {
    const p0 = pts[Math.max(i - 1, 0)], p1 = pts[i], p2 = pts[i + 1], p3 = pts[Math.min(i + 2, n - 1)];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${c1[0].toFixed(0)} ${c1[1].toFixed(0)} ${c2[0].toFixed(0)} ${c2[1].toFixed(0)} ${p2[0]} ${p2[1]}`;
  }
  return d;
}

// The vine: from under the soil, round the first station, down through the middle three, to the last
const vine = spline(
  [
    [740, 500], [740, 540], [726, 590], [694, 628], [636, 650], [560, 660], [470, 662], [380, 672], [300, 690],
    [243, 716], [214, 742], [217, 763], [262, 770], [340, 772], [402, 780], [470, 812], [560, 855], [650, 884],
    [722, 902], [758, 925], [768, 975], [764, 1030], [748, 1070], [706, 1088], [640, 1096], [540, 1100],
    [450, 1100], [395, 1106], [340, 1126], [300, 1160], [292, 1205], [305, 1240], [340, 1270], [385, 1312],
    [450, 1348], [545, 1386], [640, 1424], [705, 1452], [748, 1486], [740, 1520], [700, 1535], [640, 1545],
    [560, 1550], [480, 1556], [385, 1590], [305, 1632], [264, 1690], [247, 1745],
  ].map(([x, y]) => E(x, y)),
);

const stations = [
  {
    id: 'organic', icon: 'organic', shape: 'square', size: 182, rot: -8, at: E(182, 826),
    name: 'Organic Agriculture',
    label: { kind: 'lines', at: E(250, 806), lines: ['ORGANIC', 'AGRICULTURE'], size: 36, anchor: 'start' },
    bubble: { at: E(382, 752), w: 410, rot: -3 },
    text: 'Focuses on organic fertilizer production, natural pest control, and sustainable farming systems.',
  },
  {
    id: 'crops', icon: 'crops', shape: 'circle', size: 174, rot: 0, at: E(757, 1012),
    name: 'Agricultural Crops Production',
    label: { kind: 'arc', r: 120, a0: -155, a1: -15, text: 'AGRICULTURAL', size: 32, extra: { at: E(779, 1094), rot: -27, lines: ['CROPS', 'PRODUCTION'], size: 32 } },
    bubble: { at: E(555, 1095), w: 420, rot: -2 },
    text: 'Focuses on land preparation, plant propagation, crop care, and harvesting techniques.',
  },
  {
    id: 'horti', icon: 'horti', shape: 'square', size: 182, rot: -4, at: E(280, 1303),
    name: 'Horticulture',
    label: { kind: 'tilt', at: E(266, 1382), rot: 6, text: 'HORTICULTURE', size: 36 },
    bubble: { at: E(255, 1232), w: 380, rot: -11 },
    text: 'Deals with vegetable production, nursery management, and ornamental plant care.',
  },
  {
    id: 'aqua', icon: 'aqua', shape: 'circle', size: 168, rot: 0, at: E(745, 1470),
    name: 'Aquaculture',
    label: { kind: 'arc', r: 112, a0: -118, a1: 32, text: 'AQUACULTURE', size: 30 },
    bubble: { at: E(732, 1552), w: 410, rot: 14 },
    text: 'Covers fish culture, pond preparation, water quality management, and stock harvesting.',
  },
  {
    id: 'food', icon: 'food', shape: 'circle', size: 168, rot: 0, at: E(255, 1800),
    name: 'Food Processing',
    label: { kind: 'arc', r: 118, a0: -176, a1: -22, text: 'FOOD PROCESSING', size: 30 },
    bubble: { at: E(282, 1883), w: 420, rot: -4 },
    text: 'Teaches the science and techniques behind preserving, packaging, and processing fish and agricultural products.',
  },
];

// Wrap a bubble's text to its width and work out its height
for (const st of stations) {
  const maxChars = Math.floor((st.bubble.w - 64) / 9.4);
  const lines = [];
  let line = '';
  for (const word of st.text.split(' ')) {
    if ((line + ' ' + word).trim().length > maxChars) { lines.push(line); line = word; }
    else line = (line + ' ' + word).trim();
  }
  lines.push(line);
  st.bubble.lines = lines;
  st.bubble.h = lines.length * 25 + 34;
}

function arc(cx, cy, r, a0, a1) {
  const rad = (a) => (a * Math.PI) / 180;
  const sx = cx + r * Math.cos(rad(a0)), sy = cy + r * Math.sin(rad(a0));
  const ex = cx + r * Math.cos(rad(a1)), ey = cy + r * Math.sin(rad(a1));
  return `M${sx.toFixed(1)} ${sy.toFixed(1)}A${r} ${r} 0 ${Math.abs(a1 - a0) > 180 ? 1 : 0} 1 ${ex.toFixed(1)} ${ey.toFixed(1)}`;
}

// Scalloped bottom edge of the orange strip: 10 bumps across the page (stretches with the width)
const tile = 144;
let scallop = 'M0 0H1440V13';
for (let i = 9; i >= 0; i--) {
  const x = i * tile;
  scallop += `C${x + 108} 24 ${x + 72} 24 ${x + 72} 13C${x + 72} 2 ${x + 36} 2 ${x} 13`;
}
scallop += 'Z';

const leafShape = 'M0 0C6-14 22-18 36-12C30 3 12 9 0 0Z';
---

<section id="agri-guide" class="info" data-nav="light" aria-labelledby="info-title">
  <!-- Orange strip with a scalloped bottom edge -->
  <div class="info__strip" aria-hidden="true">
    <div class="info__strip-fill"></div>
    <svg class="info__scallop" viewBox="0 0 1440 26" preserveAspectRatio="none" focusable="false">
      <path d={scallop} />
    </svg>
  </div>

  <div class="vine">
    <h2 id="info-title" class="v-title" data-split>
      <span class="ln">What do you</span>
      <span class="ln"><span class="mark">actually</span> do</span>
      <span class="ln">in <span class="orange">Agri?</span></span>
    </h2>
    <p class="v-sub" data-reveal>
      <span class="ln">5 Applied Concepts &amp;</span>
      <span class="ln">Technologies</span>
    </p>
    <div class="v-arrow" aria-hidden="true"><Scribble name="loop-curl" /></div>
    <p class="v-lead" data-reveal>na pwede mong pag-aralan at matutunan sa <b>SHS Agri-Fishery Elective!</b></p>

    <!-- ===== Desktop: the whole drawing ===== -->
    <div class="vine--d" data-vine="desktop">
      <svg class="vine__svg" viewBox="0 0 1440 2760" role="img" aria-label="A vine growing from a plant, passing through five farming topics: Organic Agriculture, Agricultural Crops Production, Horticulture, Aquaculture, and Food Processing">
        <defs>
          {stations.map((st) => st.label.kind === 'arc' && <path id={`arc-${st.id}`} d={arc(st.at[0], st.at[1], st.label.r, st.label.a0, st.label.a1)} />)}
        </defs>

        <path class="vine__path" d={vine} fill="none" stroke="#4f7d37" stroke-width="20" stroke-linecap="round" stroke-linejoin="round" />
        <g class="vine__tip" aria-hidden="true">
          <path d={leafShape} transform="rotate(-48) scale(.9)" fill="#7cb552" />
          <path d={leafShape} transform="rotate(48) scale(-.9 .9)" fill="#6aa84a" />
          <circle r="8" fill="#a7d36a" />
        </g>

        <g transform="translate(877 225)"><VinePlant /></g>

        <g class="vine__stations">
          {stations.map((st) => {
            const [cx, cy] = st.at;
            const half = st.size / 2;
            const k = (st.size * 0.95) / 100;
            const b = st.bubble;
            return (
              <g class="st" data-st data-cx={cx} data-cy={cy} data-id={st.id}>
                <g transform={`translate(${cx} ${cy}) rotate(${st.rot})`}>
                  <g class="st-badge">
                    <circle class="st-ring" r={half + 6} fill="none" stroke="#4f7d37" stroke-width="5" opacity="0" />
                    {st.shape === 'square'
                      ? <rect x={-half} y={-half} width={st.size} height={st.size} rx={st.size * 0.17} fill="#d5df7b" />
                      : <circle r={half} fill="#d5df7b" />}
                    <g transform={`translate(${-50 * k} ${-50 * k}) scale(${k})`}><VineIcon name={st.icon} /></g>
                  </g>
                </g>

                <g class="st-label">
                  {st.label.kind === 'lines' && (
                    <text x={st.label.at[0]} y={st.label.at[1]} font-size={st.label.size} text-anchor={st.label.anchor}>
                      {st.label.lines.map((l, i) => <tspan x={st.label.at[0]} dy={i ? st.label.size * 1.06 : st.label.size * 0.9}>{l}</tspan>)}
                    </text>
                  )}
                  {st.label.kind === 'tilt' && (
                    <text transform={`translate(${st.label.at[0]} ${st.label.at[1]}) rotate(${st.label.rot})`} font-size={st.label.size} text-anchor="middle">{st.label.text}</text>
                  )}
                  {st.label.kind === 'arc' && (
                    <text font-size={st.label.size}><textPath href={`#arc-${st.id}`} startOffset="50%" text-anchor="middle">{st.label.text}</textPath></text>
                  )}
                  {st.label.extra && (
                    <text transform={`translate(${st.label.extra.at[0]} ${st.label.extra.at[1]}) rotate(${st.label.extra.rot})`} font-size={st.label.extra.size}>
                      {st.label.extra.lines.map((l, i) => <tspan x="0" dy={i ? st.label.extra.size * 1.04 : 0}>{l}</tspan>)}
                    </text>
                  )}
                </g>

                <g transform={`translate(${b.at[0]} ${b.at[1]}) rotate(${b.rot})`}>
                  <g class="st-bubble">
                    <rect x={-b.w / 2} y={-b.h / 2} width={b.w} height={b.h} rx={Math.min(b.h / 2, 38)} fill="#fff6e3" stroke="#6b8f4a" stroke-width="3" />
                    <text class="st-text" text-anchor="middle" font-size="20">
                      {b.lines.map((l, i) => <tspan x="0" y={-b.h / 2 + 30 + i * 25}>{l}</tspan>)}
                    </text>
                  </g>
                </g>
              </g>
            );
          })}
        </g>
      </svg>
    </div>

    <!-- ===== Phones and tablets: the stations as a list, the vine beside it ===== -->
    <div class="vine--m" data-vine="mobile">
      <svg class="vm__plant" viewBox="0 0 340 680" aria-hidden="true" focusable="false"><VinePlant /></svg>
      <div class="vm__track">
        <svg class="vine__svg vm__svg" aria-hidden="true" focusable="false">
          <path class="vine__path" fill="none" stroke="#4f7d37" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
          <g class="vine__tip">
            <path d={leafShape} transform="rotate(-48) scale(.55)" fill="#7cb552" />
            <path d={leafShape} transform="rotate(48) scale(-.55 .55)" fill="#6aa84a" />
            <circle r="5" fill="#a7d36a" />
          </g>
        </svg>
        <ol class="vm__list">
          {stations.map((st) => (
            <li class="sm" data-st data-id={st.id}>
              <svg class="sm__badge" viewBox="-52 -52 104 104" aria-hidden="true" focusable="false">
                <g transform={`rotate(${st.rot})`}>
                  <g class="st-badge">
                    <circle class="st-ring" r="49" fill="none" stroke="#4f7d37" stroke-width="3" opacity="0" />
                    {st.shape === 'square'
                      ? <rect x="-44" y="-44" width="88" height="88" rx="15" fill="#d5df7b" />
                      : <circle r="46" fill="#d5df7b" />}
                    <g transform="translate(-44 -44) scale(.88)"><VineIcon name={st.icon} /></g>
                  </g>
                </g>
              </svg>
              <div class="sm__body">
                <h3 class="st-label">{st.name}</h3>
                <p class="st-bubble">{st.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .info {
    position: relative;
    overflow: hidden;
    background: var(--cream);
    color: var(--brown);
    padding: 7rem 0 3rem;
  }

  .info__strip {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
  }

  .info__strip-fill {
    height: 2.2rem;
    background: var(--orange);
  }

  .info__scallop {
    display: block;
    width: 100%;
    height: 26px;
    margin-top: -1px;
    fill: var(--orange);
  }

  .ln {
    display: block;
  }

  .vine {
    position: relative;
    padding-inline: var(--gutter);
  }

  /* ---------- headline block ---------- */
  .v-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 9.5vw, 3rem);
    text-transform: uppercase;
    line-height: 1.02;
    color: var(--green);
  }

  .mark {
    background: linear-gradient(transparent 10%, var(--yellow) 10% 92%, transparent 92%) no-repeat 0 0 / var(--mark, 100%) 100%;
    padding-inline: 0.08em;
  }

  .orange {
    color: var(--orange-ink);
  }

  .v-sub {
    margin-top: 1.2rem;
    font-family: var(--font-sub);
    word-spacing: var(--sub-ws);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--brown);
  }

  .v-arrow {
    display: none;
  }

  .v-lead {
    margin-top: 0.7rem;
    max-width: 26rem;
    font-size: 1rem;
    line-height: 1.3;
  }

  .v-lead b {
    color: var(--orange-ink-sm);
  }

  .vine--d {
    display: none;
  }

  /* ---------- station art (shared by both layouts) ---------- */
  .vine :global(.vi .ic) {
    fill: none;
    stroke: var(--green);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .vine :global(.vi .fl) {
    fill: var(--green);
  }

  .vine :global(.vi .cut) {
    fill: none;
    stroke: #d5df7b;
    stroke-width: 3.5;
    stroke-linecap: round;
  }

  .vine :global(.vi .cut-fill) {
    fill: #d5df7b;
  }

  .vine :global(.st-label text),
  .vine :global(text.st-lab) {
    fill: var(--green);
    font-family: var(--font-display);
  }

  .vine :global(.st-text) {
    fill: var(--brown);
    font-family: var(--font-body);
    font-weight: 500;
  }

  /* the leaf pair at the vine's tip is placed and shown by the script; without it, it stays hidden */
  .vine :global(.vine__tip) {
    opacity: 0;
  }

  /* Once an icon is awake, a part of it keeps moving gently. (JS adds .is-on when the vine arrives.) */
  .vine :global(.mv) {
    transform-box: fill-box;
  }

  .vine :global(.is-on .sway) {
    transform-origin: 50% 100%;
    animation: v-sway 3.4s ease-in-out infinite;
  }

  .vine :global(.is-on .sway--1) {
    animation-delay: -1.1s;
  }

  .vine :global(.is-on .sway--2) {
    animation-delay: -2.2s;
  }

  .vine :global(.is-on .grow) {
    transform-origin: 50% 100%;
    animation: v-grow 2.6s ease-in-out infinite;
  }

  .vine :global(.is-on .spin) {
    transform-origin: 50% 50%;
    animation: v-spin 14s linear infinite;
  }

  .vine :global(.is-on .swim) {
    transform-origin: 50% 50%;
    animation: v-swim 3.2s ease-in-out infinite;
  }

  @keyframes v-sway {
    0%,
    100% {
      transform: rotate(-4deg);
    }
    50% {
      transform: rotate(4deg);
    }
  }

  @keyframes v-grow {
    0%,
    100% {
      transform: scale(0.92);
    }
    50% {
      transform: scale(1.08);
    }
  }

  @keyframes v-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes v-swim {
    0%,
    100% {
      transform: translate(-2px, 1px) rotate(-3deg);
    }
    50% {
      transform: translate(3px, -2px) rotate(3deg);
    }
  }

  /* ================= Phones and tablets ================= */
  .vm__plant {
    display: block;
    width: min(62%, 15rem);
    height: auto;
    margin: 1.2rem 0 0 auto;
    overflow: visible;
  }

  .vm__track {
    position: relative;
    margin-top: -2.4rem;
  }

  .vm__svg {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .vm__list {
    position: relative;
    display: grid;
    gap: 2.6rem;
    margin: 0;
    padding: 4.5rem 0 1rem;
    list-style: none;
  }

  .sm {
    display: grid;
    grid-template-columns: 5.2rem 1fr;
    gap: 1rem;
    align-items: center;
  }

  .sm__badge {
    width: 5.2rem;
    height: 5.2rem;
    overflow: visible;
  }

  .sm__body h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--green);
  }

  .sm__body p {
    margin-top: 0.45rem;
    padding: 0.7rem 0.95rem;
    border: 2px solid #6b8f4a;
    border-radius: 1.1rem;
    background: #fff6e3;
    font-size: 0.92rem;
    line-height: 1.3;
  }

  /* before the animation starts, the stations wait (without scripts, with reduced motion, or if the animation
     cannot start, they simply show) */
  :global(html.js:not(.rm):not(.anim-fail)) .vine :global([data-st]) {
    visibility: hidden;
  }

  /* ================= Desktop: the drawing ================= */
  @media (min-width: 960px) {
    .info {
      padding: 0;
    }

    .info__strip-fill {
      height: calc(var(--u) * 6.8);
    }

    .info__scallop {
      height: calc(var(--u) * 2.5);
    }

    .vine {
      height: calc(var(--u) * 191.7);
      padding: 0;
    }

    .vine--m {
      display: none;
    }

    .vine--d {
      display: block;
    }

    .vine__svg {
      position: absolute;
      left: var(--gx);
      top: 0;
      width: calc(var(--u) * 100);
      height: calc(var(--u) * 191.7);
      overflow: visible;
    }

    .v-title,
    .v-sub,
    .v-lead,
    .v-arrow {
      position: absolute;
      z-index: 2;
    }

    .v-title {
      left: calc(var(--gx) + var(--u) * 11.2);
      top: calc(var(--u) * 20.8);
      font-size: calc(var(--u) * 5.4);
    }

    .v-sub {
      left: calc(var(--gx) + var(--u) * 11.7);
      top: calc(var(--u) * 38.8);
      margin: 0;
      font-size: calc(var(--u) * 3.5);
    }

    .v-arrow {
      display: block;
      left: calc(var(--gx) + var(--u) * 53.8);
      top: calc(var(--u) * 38.6);
      width: calc(var(--u) * 5.8);
      color: var(--brown);
    }

    .v-lead {
      left: calc(var(--gx) + var(--u) * 11.7);
      top: calc(var(--u) * 47.7);
      max-width: calc(var(--u) * 46);
      margin: 0;
      font-size: calc(var(--u) * 2);
      line-height: 1.12;
    }

    .vine :global(.st-label text) {
      font-weight: 400;
    }

    /* labels are in the SVG's own units, bubbles' text too */
    .vine--d :global(.st-label) {
      text-transform: uppercase;
    }
  }
</style>
